FROM crystallang/crystal:1.20.1 AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libevent-dev libpq-dev librocksdb-dev libsqlite3-dev libssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY shard.yml shard.lock ./
RUN shards install --frozen

COPY src/ src/
RUN mkdir -p bin && \
    crystal build --release --no-debug src/bin/crystalcog.cr -o bin/crystalcog && \
    crystal build --release --no-debug src/bin/cogserver.cr -o bin/cogserver && \
    crystal build --release --no-debug src/bin/cogshell.cr -o bin/cogshell && \
    crystal build --release --no-debug src/bin/aphrodite_jax_server.cr -o bin/aphrodite_jax_server

FROM ubuntu:24.04 AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates libevent-2.1-7 libgc1 libpcre2-8-0 libpq5 \
      librocksdb8.9 libsqlite3-0 libssl3t64 libyaml-0-2 zlib1g && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system crystalcog && \
    useradd --system --gid crystalcog --home-dir /app crystalcog

WORKDIR /app
COPY --from=builder /build/bin/ /usr/local/bin/

RUN mkdir -p /app/data && chown -R crystalcog:crystalcog /app
USER crystalcog

ENV PLATFORM_HOST=0.0.0.0 \
    PAPHOS_DATA_FILE=/app/data/paphos.json \
    CRYSTALCOG_ENV=production

EXPOSE 3000 8080 17001 18080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bash -c ': >/dev/tcp/127.0.0.1/8080'

CMD ["/usr/local/bin/crystalcog", "platform"]
